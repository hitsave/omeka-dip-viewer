<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$maxMb = max(1, (int) round($galleryMaxBytes / 1048576));
$total = count($galleryFiles);
$maxDisplay = (int) ($galleryMaxDisplay ?? 0);
if ($maxDisplay <= 0) {
    $maxDisplay = $total;
}
$initialCount = min($total, $maxDisplay);
$hiddenCount = max(0, $total - $initialCount);
$visibleFiles = array_slice($galleryFiles, 0, $initialCount, true);
$deferredFiles = $hiddenCount > 0 ? array_slice($galleryFiles, $initialCount, null, true) : [];
$packagedGrid = is_array($previewManifest ?? null) ? ($previewManifest['grid'] ?? []) : [];
$galleryIndexJson = '[]';
if ($total > 0) {
    $galleryIndex = [];
    foreach ($galleryFiles as $file) {
        $fileKey = (string) ($file['key'] ?? '');
        $fullSrc = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
        $thumbSrc = isset($packagedGrid[$fileKey])
            ? $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null)
            : $fullSrc;
        $galleryIndex[] = [
            'key' => $fileKey,
            'src' => $thumbSrc,
            'fullSrc' => $fullSrc,
            'label' => (string) ($file['label'] ?? $file['relative_path'] ?? $file['key'] ?? ''),
        ];
    }
    $galleryIndexJson = json_encode(
        $galleryIndex,
        JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    );
}
?>
<section class="omeka-dip-gallery" aria-label="<?= $escape($translate('Image preview')) ?>">
    <script type="application/json" class="omeka-dip-gallery-index"><?= $galleryIndexJson ?></script>
    <h4><?= $escape($translate('Images')) ?> <?= $total > 0 ? $escape('(' . number_format($total) . ')') : '' ?></h4>
    <p class="omeka-dip-gallery-note">
        <?= $escape(sprintf(
            $translate('JPEG, PNG, GIF, and WebP under %s MB. Drag or scroll over the carousel (trackpad or wheel); click a slide to enlarge; in the enlarged view use arrow keys or swipe left/right (or the on-screen arrows) to step through all %s gallery images. Other files are listed under package contents.'),
            $maxMb,
            number_format($total)
        )) ?>
    </p>
    <div class="omeka-dip-embla">
        <div class="omeka-dip-embla__viewport">
            <div class="omeka-dip-embla__container">
                <?php foreach ($visibleFiles as $file): ?>
                    <?php
                    $fileKey = (string) ($file['key'] ?? '');
                    $fullHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
                    $thumbHref = isset($packagedGrid[$fileKey])
                        ? $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null)
                        : $fullHref;
                    $label = $file['label'] ?? $file['relative_path'] ?? $file['key'];
                    ?>
                    <div class="omeka-dip-embla__slide omeka-dip-gallery-item">
                        <div
                            class="omeka-dip-gallery-open"
                            role="button"
                            tabindex="0"
                            data-dip-key="<?= $escape($fileKey) ?>"
                            data-dip-src="<?= $escape($thumbHref) ?>"
                            data-dip-full-src="<?= $escape($fullHref) ?>"
                            data-dip-label="<?= $escape($label) ?>"
                        >
                            <img
                                data-dip-src="<?= $escape($thumbHref) ?>"
                                alt="<?= $escape($label) ?>"
                                decoding="async"
                                draggable="false"
                                class="omeka-dip-gallery-thumb"
                            >
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
        <div class="omeka-dip-embla__controls">
            <button type="button" class="omeka-dip-embla__prev button secondary" aria-label="<?= $escape($translate('Previous')) ?>">‹</button>
            <button type="button" class="omeka-dip-embla__next button secondary" aria-label="<?= $escape($translate('Next')) ?>">›</button>
        </div>
    </div>
    <?php if ($hiddenCount > 0): ?>
        <template class="omeka-dip-gallery-more-slides">
            <?php foreach ($deferredFiles as $file): ?>
                <?php
                $fileKey = (string) ($file['key'] ?? '');
                $fullHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
                $thumbHref = isset($packagedGrid[$fileKey])
                    ? $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null)
                    : $fullHref;
                $label = $file['label'] ?? $file['relative_path'] ?? $file['key'];
                ?>
                <div class="omeka-dip-embla__slide omeka-dip-gallery-item">
                    <div
                        class="omeka-dip-gallery-open"
                        role="button"
                        tabindex="0"
                        data-dip-key="<?= $escape($fileKey) ?>"
                        data-dip-src="<?= $escape($thumbHref) ?>"
                        data-dip-full-src="<?= $escape($fullHref) ?>"
                        data-dip-label="<?= $escape($label) ?>"
                    >
                        <img
                            data-dip-src="<?= $escape($thumbHref) ?>"
                            alt="<?= $escape($label) ?>"
                            decoding="async"
                            draggable="false"
                            class="omeka-dip-gallery-thumb"
                        >
                    </div>
                </div>
            <?php endforeach; ?>
        </template>
        <p class="omeka-dip-gallery-more-wrap">
            <button type="button" class="omeka-dip-gallery-show-all button">
                <?= $escape(sprintf($translate('Show all %s images'), number_format($total))) ?>
            </button>
            <span class="omeka-dip-gallery-more-hint">
                <?= $escape(sprintf(
                    $translate('Showing %s of %s in carousel'),
                    number_format($initialCount),
                    number_format($total)
                )) ?>
            </span>
        </p>
    <?php endif; ?>
    <dialog class="omeka-dip-gallery-dialog" aria-label="<?= $escape($translate('Enlarged image')) ?>">
        <form method="dialog">
            <button type="submit" class="omeka-dip-gallery-close" aria-label="<?= $escape($translate('Close')) ?>">×</button>
        </form>
        <button type="button" class="omeka-dip-gallery-lightbox-prev" data-dip-lightbox-nav="-1" aria-label="<?= $escape($translate('Previous image')) ?>">‹</button>
        <button type="button" class="omeka-dip-gallery-lightbox-next" data-dip-lightbox-nav="1" aria-label="<?= $escape($translate('Next image')) ?>">›</button>
        <figure class="omeka-dip-gallery-dialog-body">
            <img src="" alt="" class="omeka-dip-gallery-full" draggable="false">
            <figcaption class="omeka-dip-gallery-caption"></figcaption>
        </figure>
    </dialog>
</section>
