<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$previewKeys = is_array($packagedPreviewKeys ?? null) ? $packagedPreviewKeys : [];
$total = count($previewKeys);
if ($total === 0) {
    return;
}
$galleryIndex = [];
foreach ($previewKeys as $fileKey) {
    $fileKey = (string) $fileKey;
    $thumbHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null);
    $fullHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
    $label = $fileKey === 'menu' ? (string) $translate('DVD menu') : $fileKey;
    $galleryIndex[] = [
        'key' => $fileKey,
        'src' => $thumbHref,
        'fullSrc' => $fullHref,
        'label' => $label,
    ];
}
$galleryIndexJson = json_encode(
    $galleryIndex,
    JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
);
$countClass = $total === 1 ? ' omeka-dip-gallery--count-1' : '';
?>
<section class="omeka-dip-gallery omeka-dip-packaged-previews<?= $countClass ?>" aria-label="<?= $escape($translate('Package preview')) ?>">
    <script type="application/json" class="omeka-dip-gallery-index"><?= $galleryIndexJson ?></script>
    <h4><?= $escape($translate('Preview')) ?></h4>
    <p class="omeka-dip-gallery-note">
        <?= $escape($translate('Packaged preview from the preservation copy. Disc images and other dump payload files are not published here.')) ?>
    </p>
<?php if ($total === 1): ?>
    <?php
    $fileKey = (string) $previewKeys[0];
    $thumbHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null);
    $fullHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
    $label = $fileKey === 'menu' ? (string) $translate('DVD menu') : $fileKey;
    ?>
    <div class="omeka-dip-packaged-preview-hero">
        <div class="omeka-dip-embla__slide omeka-dip-gallery-item">
            <div
                class="omeka-dip-gallery-open"
                role="button"
                tabindex="0"
                data-dip-key="<?= $escape($fileKey) ?>"
                data-dip-src="<?= $escape($thumbHref) ?>"
                data-dip-full-src="<?= $escape($fullHref) ?>"
                data-dip-label="<?= $escape($label) ?>"
            >
                <img
                    data-dip-src="<?= $escape($thumbHref) ?>"
                    alt="<?= $escape($label) ?>"
                    decoding="async"
                    draggable="false"
                    class="omeka-dip-gallery-thumb"
                >
            </div>
        </div>
    </div>
<?php else: ?>
    <div class="omeka-dip-embla">
        <div class="omeka-dip-embla__viewport">
            <div class="omeka-dip-embla__container">
                <?php foreach ($previewKeys as $fileKey): ?>
                <?php
                $fileKey = (string) $fileKey;
                $thumbHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, 'thumb', $siteSlug ?? null);
                $fullHref = $this->dipFileUrl($itemId, $mediaId, $fileKey, null, $siteSlug ?? null);
                $label = $fileKey === 'menu' ? (string) $translate('DVD menu') : $fileKey;
                ?>
                <div class="omeka-dip-embla__slide omeka-dip-gallery-item">
                    <div
                        class="omeka-dip-gallery-open"
                        role="button"
                        tabindex="0"
                        data-dip-key="<?= $escape($fileKey) ?>"
                        data-dip-src="<?= $escape($thumbHref) ?>"
                        data-dip-full-src="<?= $escape($fullHref) ?>"
                        data-dip-label="<?= $escape($label) ?>"
                    >
                        <img
                            data-dip-src="<?= $escape($thumbHref) ?>"
                            alt="<?= $escape($label) ?>"
                            decoding="async"
                            draggable="false"
                            class="omeka-dip-gallery-thumb"
                        >
                    </div>
                </div>
                <?php endforeach; ?>
            </div>
        </div>
        <div class="omeka-dip-embla__controls">
            <button type="button" class="omeka-dip-embla__prev button secondary" aria-label="<?= $escape($translate('Previous')) ?>">‹</button>
            <button type="button" class="omeka-dip-embla__next button secondary" aria-label="<?= $escape($translate('Next')) ?>">›</button>
        </div>
    </div>
<?php endif; ?>
    <dialog class="omeka-dip-gallery-dialog" aria-label="<?= $escape($translate('Enlarged image')) ?>">
        <form method="dialog">
            <button type="submit" class="omeka-dip-gallery-close" aria-label="<?= $escape($translate('Close')) ?>">×</button>
        </form>
        <button type="button" class="omeka-dip-gallery-lightbox-prev" data-dip-lightbox-nav="-1" aria-label="<?= $escape($translate('Previous image')) ?>">‹</button>
        <button type="button" class="omeka-dip-gallery-lightbox-next" data-dip-lightbox-nav="1" aria-label="<?= $escape($translate('Next image')) ?>">›</button>
        <figure class="omeka-dip-gallery-dialog-body">
            <img src="" alt="" class="omeka-dip-gallery-full" draggable="false">
            <figcaption class="omeka-dip-gallery-caption"></figcaption>
        </figure>
    </dialog>
</section>
