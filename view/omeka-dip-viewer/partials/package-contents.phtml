<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$mediaId = $media->id();
$filesByKey = [];
foreach ($index['files'] as $file) {
    $filesByKey[$file['key']] = $file;
}
$tree = $index['tree'] ?? null;

$view = $this;
$itemId = (int) ($itemId ?? $media->item()->id());
$openInViewer = is_array($openInViewer ?? null) ? $openInViewer : [];
$renderFileLink = function (array $file, bool $showFullPath = false) use ($escape, $translate, $itemId, $mediaId, $view, $siteSlug, $openInViewer): string {
    $key = (string) $file['key'];
    $href = $view->dipFileUrl($itemId, $mediaId, $key, null, $siteSlug ?? null);
    $label = $file['label'];
    if ($showFullPath && !empty($file['relative_path'])) {
        $label = $file['relative_path'];
    }
    $size = !empty($file['size'])
        ? ' <span class="omeka-dip-size">(' . $escape(number_format((int) $file['size'])) . ' B)</span>'
        : '';
    if (($file['download'] ?? true) === false) {
        // Programs on disc contents: listed, never served.
        return '<span class="omeka-dip-file-nodownload">' . $escape($label) . '</span>' . $size
            . ' <span class="omeka-dip-size">' . $escape($translate('program, not downloadable')) . '</span>';
    }
    $kind = $openInViewer[$key] ?? null;
    if ($kind === null) {
        return '<a href="' . $escape($href) . '">' . $escape($label) . '</a>' . $size;
    }
    // Opens in the viewer (lightbox, video player, PDF in a new tab); the original stays a download.
    $openHref = $href;
    $target = '';
    if ($kind === 'document') {
        $isCopy = strtolower((string) ($file['access_mime'] ?? '')) === 'application/pdf';
        $openHref = $view->dipFileUrl($itemId, $mediaId, $key, $isCopy ? 'access' : null, $siteSlug ?? null);
        $target = ' target="_blank" rel="noopener"';
    }

    return '<a href="' . $escape($openHref) . '" data-dip-open="' . $escape($kind) . '" data-dip-key="'
        . $escape($key) . '"' . $target . '>' . $escape($label) . '</a>' . $size
        . ' <a href="' . $escape($href) . '" class="omeka-dip-file-download" title="'
        . $escape($translate('Download original')) . '" aria-label="' . $escape($translate('Download original') . ': ' . $label)
        . '">&#8595;</a>';
};

// Folders collapse like a file browser (<details>). Small packages open fully; larger ones open the
// top level only, so a big press kit doesn't start as a wall of files.
$countFiles = null;
$countFiles = function (array $node) use (&$countFiles): int {
    $n = count($node['files'] ?? []);
    foreach ($node['children'] ?? [] as $child) {
        $n += $countFiles($child);
    }
    return $n;
};
$openAllBelow = 40;
$totalFiles = is_array($tree) ? $countFiles($tree) : 0;
$hasFolders = is_array($tree) && !empty($tree['children']);
$renderTree = null;
$renderTree = function (array $node, int $depth = 0) use (&$renderTree, $escape, $filesByKey, $renderFileLink, $countFiles, $totalFiles, $openAllBelow): void {
    $hasChildren = !empty($node['children']);
    $hasFiles = !empty($node['files']);
    if (!$hasChildren && !$hasFiles) {
        return;
    }
    echo '<ul class="omeka-dip-tree">';
    foreach ($node['files'] ?? [] as $fileKey) {
        $file = $filesByKey[$fileKey] ?? null;
        if (!$file) {
            continue;
        }
        echo '<li class="omeka-dip-file">' . $renderFileLink($file) . '</li>';
    }
    foreach ($node['children'] ?? [] as $child) {
        $open = $totalFiles <= $openAllBelow || $depth === 0;
        echo '<li class="omeka-dip-folder"><details class="omeka-dip-folder-details"' . ($open ? ' open' : '') . '>';
        echo '<summary><span class="omeka-dip-folder-name">' . $escape($child['name']) . '</span>'
            . ' <span class="omeka-dip-folder-count">' . $escape(number_format($countFiles($child))) . '</span></summary>';
        $renderTree($child, $depth + 1);
        echo '</details></li>';
    }
    echo '</ul>';
};
?>
<aside class="omeka-dip-package__contents" aria-label="<?= $escape($translate('Package contents')) ?>">
    <h4><?= $escape($translate('Package contents')) ?></h4>
<?php if ($tree && (!empty($tree['children']) || !empty($tree['files']))): ?>
    <?php if ($hasFolders): ?>
        <p class="omeka-dip-tree-toggles">
            <button type="button" class="omeka-dip-tree-toggle" data-dip-tree-open="1"><?= $escape($translate('Expand all')) ?></button>
            <button type="button" class="omeka-dip-tree-toggle" data-dip-tree-open="0"><?= $escape($translate('Collapse all')) ?></button>
        </p>
    <?php endif; ?>
    <div class="omeka-dip-tree-root">
        <?php $renderTree($tree); ?>
    </div>
<?php else: ?>
    <ul class="omeka-dip-file-list">
        <?php foreach ($index['files'] as $file): ?>
            <li>
                <?= $renderFileLink($file, true) ?>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>
</aside>
