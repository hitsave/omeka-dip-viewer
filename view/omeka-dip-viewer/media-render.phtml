<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$mediaId = $media->id();
$itemId = (int) $media->item()->id();
$siteSlug = $siteSlug ?? null;
?>
<div class="omeka-dip-package" data-dip-kind="<?= $escape($packageKind ?? 'package') ?>">
    <div class="omeka-dip-package__media">
<?php if (!empty($galleryFiles)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/gallery', [
        'galleryFiles' => $galleryFiles,
        'galleryMaxBytes' => $galleryMaxBytes ?? 52428800,
        'galleryMaxDisplay' => $galleryMaxDisplay ?? 48,
        'mediaId' => $mediaId,
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
        'previewManifest' => $previewManifest ?? null,
    ]) ?>
<?php endif; ?>
<?php if (!empty($videoFiles)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/videos', [
        'videoFiles' => $videoFiles,
        'previewManifest' => $previewManifest ?? null,
        'mediaId' => $mediaId,
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
    ]) ?>
<?php endif; ?>
<?php if (!empty($documentFiles)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/documents', [
        'documentFiles' => $documentFiles,
        'previewManifest' => $previewManifest ?? null,
        'mediaId' => $mediaId,
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
    ]) ?>
<?php endif; ?>
<?php if (!empty($packagedPreviewKeys)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/packaged-previews', [
        'packagedPreviewKeys' => $packagedPreviewKeys,
        'packagedPreviewLabels' => $packagedPreviewLabels ?? [],
        'duplicateOriginals' => $duplicateOriginals ?? [],
        'mediaId' => $mediaId,
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
    ]) ?>
<?php endif; ?>
<?php if ($largePackage): ?>
        <p class="omeka-dip-warning">
            <?= $escape(sprintf(
                $translate('Large DIP (%s bytes, threshold %s). Review before publishing.'),
                number_format($dipSizeBytes),
                number_format($thresholdBytes)
            )) ?>
        </p>
<?php endif; ?>
    </div>
<?php if (!empty($scanFiles)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/scan-contents', [
        'scanFiles' => $scanFiles,
        'mediaId' => $mediaId,
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
    ]) ?>
<?php endif; ?>
<?php if (!empty($showPackageContents)): ?>
    <?= $this->partial('omeka-dip-viewer/partials/package-contents', [
        'media' => $media,
        'index' => $index,
        'openInViewer' => $openInViewer ?? [],
        'itemId' => $itemId,
        'siteSlug' => $siteSlug,
    ]) ?>
<?php endif; ?>
</div>
